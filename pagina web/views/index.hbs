  <div id="Conocenos" class="row py-4 scroll_section">
    <div class="col-md-4 offset-md-2">
      <h2>Visitanos</h2>
      <div class="mapa">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d1502.0214402608738!2d-71.32037581992134!3d-41.155415649263865!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zNDHCsDA5JzE4LjkiUyA3McKwMTknMDguOSJX!5e0!3m2!1ses!2sar!4v1785196079350!5m2!1ses!2sar"></iframe>
      </div>
    </div>
    <div class="col-md-4 mt-4 mt-md-0">
      <h2>Contactanos</h2>

      <form class="row g-3" action="/" method="post">
        <div class="col-md-6">
          <label for="inputEmail4" class="form-label">Nombre</label>
          <input type="text" class="form-control" id="nombre" name="nombre">
        </div>
        <div class="col-md-6">
          <label for="inputPassword4" class="form-label">Apellido</label>
          <input type="text" class="form-control" id="apellido" name="apellido">
        </div>
        <div class="col-12">
          <label for="inputAddress" class="form-label">Email</label>
          <input type="text" class="form-control" id="email" name="email" placeholder="Email@email.com">
        </div>
        <div class="col-12">
          <label for="inputAddress2" class="form-label">Teléfono</label>
          <input type="text" class="form-control" id="telefono" name="telefono" placeholder="....">
        </div>
        <div class="col-12">
          <label for="inputAddress2" class="form-label">Mensaje</label>
          <textarea class="form-control" id="mensaje" name="mensaje" rows="3"></textarea>
        </div>


        <div class="col-12">
          <button type="submit" class="btn btn-primary">Enviar</button>
        </div>
      </form>
      {{message}}
    </div>
  </div>


