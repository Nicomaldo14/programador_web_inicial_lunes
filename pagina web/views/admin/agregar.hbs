<div class="container" style="margin:100px auto">
    <div class="row">
        <div class="col-6 offset-3">
            <h5>Agregar una Novedad</h5>
            <form action="/admin/novedades/agregar" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <input type="text" class="form-control" name="titulo" placeholder="Titulo">
            </div>
            <div class="form-group">
                <textarea class="form-control" name="subtitulo" placeholder="Subtitulo"></textarea>
            </div>
            <div class="form-group">
                <textarea class="form-control" name="cuerpo" placeholder="Cuerpo"></textarea>
            </div>
            <div class="form-group">
                <label>Imagen: <input type="file" name="imagen" id="imagen"/></label>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            </form>
            {{#if error}}
            <p>{{message}}</p>
            {{/if}}
        </div>
    </div>
</div>